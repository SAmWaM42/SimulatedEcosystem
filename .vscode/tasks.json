{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (CMake)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "collapse": true,
                "reveal": "silent",
                "focus": false,
                "panel": "new"
            },
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^([^\\s].*)\\.(\\w+):(?:(\\d+):)?(?:(\\d+):)?\\s+(warning|error):\\s+(.*)$",
                    "module": 1,
                    "file": 1,
                    "extension": 2,
                    "line": 3,
                    "column": 4,
                    "severity": 5,
                    "message": 6
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "cmake",
                    "endsPattern": "Built target"
                }
            }
        },
        {
            "label": "Run",
            "type": "shell",
            "command": "${workspaceFolder}/build/program",
            "isBuildCommand": false,
            "presentation": {
                "echo": true,
                "collapse": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}
